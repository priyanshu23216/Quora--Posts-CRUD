<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Request</title>
    <link rel="stylesheet" href="/css/edit.css">
</head>
<body>
    <h1>Edit Content</h1>
    <form action="/<%= username %>/<%= userId %>?_method=PATCH" method="POST">
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" value="<%= user.username %>" required>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="<%= user.email %>" required>

        <label for="country">Country:</label>
        <input type="text" id="country" name="country" value="<%= user.country %>" required>

        <label for="content">Content:</label>
        <textarea id="content" name="content" required><%= user.content %></textarea>

        <a href="/<%= username %>/<%= userId %>">Cancel</a>
        <button type="submit">Update</button>

    </form>
</body>
</html> 